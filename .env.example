APP_NAME=Gold Shop API
APP_VERSION=0.1.0
DEBUG=true

DATABASE_URL=postgresql+asyncpg://goldshop:goldshop_password@localhost:5432/goldshop

REDIS_URL=redis://localhost:6379/0

TEST_DATABASE_URL=postgresql+asyncpg://goldshop:goldshop_password@localhost:5432/goldshop_test

TEST_REDIS_URL=redis://localhost:6379/1

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM = HS256
# JSON list of frontend origins, for example ["http://localhost:5173"]
CORS_ORIGINS=[]

# Mount this directory persistently in production and include it in backups.
ITEM_IMAGE_DIR=var/item-images

# Calendar boundaries for monthly dashboard reports (IANA timezone).
REPORT_TIMEZONE=Asia/Beirut

# Development reset: requires BOTH settings. Keep disabled outside disposable development.
APP_ENVIRONMENT=development
ENABLE_DEV_RESET=true
